\centering
\footnotesize
\begin{tabular}{@{}p{0.42\linewidth}p{0.24\linewidth}p{0.26\linewidth}@{}}
\toprule
\textbf{Fase} & \textbf{Dove} & \textbf{Cronometro} \\
\midrule
creazione del contesto CUDA & \code{local\_gemm\_create} & no: $t_{\text{setup}}^{\text{init}}$ \\
tutti i \code{cudaMalloc} in VRAM & \code{local\_gemm\_create} & no: $t_{\text{setup}}^{\text{alloc}}$ \\
H2D di $A$, una volta sola & \code{local\_gemm\_create} & no: $t_{\text{setup}}^{\text{H2D }A}$ \\
